rules_version = '2';

// UCU Wellbeing - Firestore Security Rules
// Sprint 1: users (FR1, FR9)          Sprint 2: categories, services, resources (FR2, FR3, FR6)
// Requirements: NFR1 (minimal data), NFR2 (server-side access control)
// Anything not explicitly allowed below is DENIED by default.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasProfile() && myProfile().role == 'admin';
    }
    function isStaff() {
      return hasProfile() && myProfile().role == 'staff';
    }
    function isStaffOf(serviceId) {
      return isStaff() && myProfile().serviceId == serviceId;
    }
    function isStaffOrAdmin() {
      return isStaff() || isAdmin();
    }
    function validServices() {
      return ['counselling', 'peer_counselling', 'chaplaincy', 'workshops'];
    }

    // ---------- users (FR1 + FR9) ----------
    match /users/{uid} {
      // You can read your own profile; an admin can read everyone's.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Registration: only your own profile, only as a student,
      // only these four fields, only with your own sign-in email.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email;

      allow update: if signedIn() && (
        // You may fix your own name - never your role, service or email.
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName']))
        ||
        // An admin may change SOMEONE ELSE's role/service (not their own).
        (isAdmin() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'serviceId'])
          && request.resource.data.role in ['student', 'staff', 'admin']
          && (request.resource.data.role != 'staff'
              || request.resource.data.serviceId in validServices()))
      );

      allow delete: if false;
    }

    // ---------- categories (Sprint 2) ----------
    // Labels such as "Mental health and counselling". Not sensitive, so any
    // signed-in user may read them; only an admin manages them.
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validCategory();
      allow delete: if false;
    }
    function validCategory() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'appliesTo', 'description', 'status'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.appliesTo in ['service', 'resource', 'both']
        && d.status in ['active', 'inactive'];
    }

    // ---------- services: the service directory (FR3, FR6) ----------
    // Students see only PUBLISHED services. Staff see and edit only THEIR OWN
    // service. Only an admin creates services, and only the four known ones.
    match /services/{serviceId} {
      allow read: if signedIn()
        && (resource.data.status == 'published' || isAdmin() || isStaffOf(serviceId));
      allow create: if isAdmin() && serviceId in validServices() && validService();
      allow update: if (isAdmin() || isStaffOf(serviceId))
        && validService()
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    function validService() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'description', 'categoryId', 'location', 'operatingHours',
                               'contactMethod', 'accessMethod', 'eligibility', 'whatToExpect',
                               'appointmentRequired', 'expectedResponseTime', 'status',
                               'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['name', 'status', 'appointmentRequired'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.status in ['draft', 'published']
        && d.appointmentRequired is bool;
    }

    // ---------- resources: wellbeing information (FR2, FR6) ----------
    // Students see only PUBLISHED resources. Staff create resources and edit
    // their own; an admin can edit any. Nothing is deleted - it is archived.
    // (Approval before publishing, FR7, is added in Sprint 4.)
    match /resources/{resourceId} {
      allow read: if signedIn()
        && (resource.data.status == 'published' || isStaffOrAdmin());
      allow create: if isStaffOrAdmin()
        && validResource()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if validResource()
        && request.resource.data.createdBy == resource.data.createdBy
        && (isAdmin() || (isStaff() && resource.data.createdBy == request.auth.uid));
      allow delete: if false;
    }
    function validResource() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'summary', 'content', 'resourceType', 'categoryId', 'status',
                               'createdBy', 'createdAt', 'updatedAt', 'publishedAt'])
        && d.keys().hasAll(['title', 'content', 'categoryId', 'status', 'createdBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.content is string && d.content.size() <= 20000
        && d.status in ['draft', 'published', 'archived'];
    }

    // ---------- requests (FR4, FR5, FR8, NFR1) - Sprint 3 ----------
    // A student sends a support request to ONE service.
    // Only that student and the staff of that service can ever read it.
    // Admins manage accounts, not requests, so they cannot read them (privacy).
    // Nothing is ever deleted; every change is kept in the history below.
    match /requests/{requestId} {

      function reqMe() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function reqHasProfile() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      }
      function reqIsStudent() {
        return reqHasProfile() && reqMe().role == 'student';
      }
      function reqIsStaffOf(serviceId) {
        return reqHasProfile() && reqMe().role == 'staff' && reqMe().get('serviceId', '') == serviceId;
      }
      function reqStatuses() {
        return ['submitted', 'under_review', 'info_requested', 'contacted', 'closed', 'withdrawn'];
      }
      function reqFinal() {
        return ['closed', 'withdrawn'];
      }
      function reqServicePublished(serviceId) {
        return serviceId in ['counselling', 'peer_counselling', 'chaplaincy', 'workshops']
          && exists(/databases/$(database)/documents/services/$(serviceId))
          && get(/databases/$(database)/documents/services/$(serviceId)).data.status == 'published';
      }
      function validNewRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly(['studentId', 'studentName', 'serviceId', 'requestType',
              'preferredContact', 'contactValue', 'note', 'status',
              'createdAt', 'updatedAt', 'lastUpdatedBy'])
          && d.keys().hasAll(['studentId', 'studentName', 'serviceId', 'requestType',
              'preferredContact', 'contactValue', 'status',
              'createdAt', 'updatedAt', 'lastUpdatedBy'])
          && d.studentId == request.auth.uid
          && d.lastUpdatedBy == request.auth.uid
          && d.studentName == reqMe().fullName
          && d.requestType in ['appointment', 'talk_to_someone', 'information', 'other']
          && d.preferredContact in ['call', 'sms', 'email']
          && d.contactValue is string && d.contactValue.size() >= 3 && d.contactValue.size() <= 100
          && (!('note' in d) || (d.note is string && d.note.size() <= 500))
          && d.status == 'submitted'
          && d.createdAt == request.time
          && d.updatedAt == request.time;
      }
      // Only these three fields change after a request is sent.
      function onlyStatusChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'lastUpdatedBy'])
          && request.resource.data.status in reqStatuses()
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastUpdatedBy == request.auth.uid
          && !(resource.data.status in reqFinal());
      }

      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid
        || reqIsStaffOf(resource.data.serviceId)
      );

      allow create: if reqIsStudent()
        && validNewRequest()
        && reqServicePublished(request.resource.data.serviceId);

      allow update: if request.auth != null && onlyStatusChange() && (
        // Staff of THAT service move it along (they cannot set it back to "submitted").
        (reqIsStaffOf(resource.data.serviceId)
          && request.resource.data.status in ['under_review', 'info_requested', 'contacted', 'closed'])
        ||
        // The student who sent it may withdraw it, or answer a question from staff.
        (resource.data.studentId == request.auth.uid
          && (request.resource.data.status == 'withdrawn'
              || (resource.data.status == 'info_requested'
                  && request.resource.data.status == 'under_review')))
      );

      allow delete: if false;

      // ---------- history: who changed what, and when (append-only) ----------
      match /updates/{updateId} {
        function parentPath() {
          return /databases/$(database)/documents/requests/$(requestId);
        }
        function parentAfter() {
          return getAfter(parentPath()).data;
        }
        function canSeeParent(p) {
          return p.studentId == request.auth.uid || reqIsStaffOf(p.serviceId);
        }

        allow read: if request.auth != null
          && exists(parentPath())
          && canSeeParent(get(parentPath()).data);

        allow create: if request.auth != null
          && existsAfter(parentPath())
          && (!exists(parentPath()) || !(get(parentPath()).data.status in reqFinal()))
          && request.resource.data.keys().hasOnly(['authorId', 'authorRole', 'message', 'newStatus', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'authorRole', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (!('message' in request.resource.data)
              || (request.resource.data.message is string
                  && request.resource.data.message.size() >= 1
                  && request.resource.data.message.size() <= 500))
          && (!('newStatus' in request.resource.data)
              || request.resource.data.newStatus in reqStatuses())
          && (
            (request.resource.data.authorRole == 'student' && parentAfter().studentId == request.auth.uid)
            || (request.resource.data.authorRole == 'staff' && reqIsStaffOf(parentAfter().serviceId))
          );

        allow update, delete: if false;
      }
    }
  }
}
