rules_version = '2';

// UCU Wellbeing - Firestore Security Rules (Sprint 1, Task 5)
// Requirements: FR1 (accounts), FR9 (roles), NFR1 (minimal data), NFR2 (server-side access control)
// Anything not explicitly allowed below is DENIED by default.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role == 'admin';
    }
    function validServices() {
      return ['counselling', 'peer_counselling', 'chaplaincy', 'workshops'];
    }

    // ---------- users (FR1 + FR9) ----------
    match /users/{uid} {
      // You can read your own profile; an admin can read everyone's.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Registration: only your own profile, only as a student,
      // only these four fields, only with your own sign-in email.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email;

      allow update: if signedIn() && (
        // You may fix your own name - never your role, service or email.
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName']))
        ||
        // An admin may change SOMEONE ELSE's role/service (not their own).
        (isAdmin() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'serviceId'])
          && request.resource.data.role in ['student', 'staff', 'admin']
          && (request.resource.data.role != 'staff'
              || request.resource.data.serviceId in validServices()))
      );

      allow delete: if false;
    }

    // The temporary smoke_tests rule from Task 1 has been removed.
    // New collections (services, resources, requests) get their own rules
    // in Sprints 2-4, each with tests in rules-tests/.
  }
}
